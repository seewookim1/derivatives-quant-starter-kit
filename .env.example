# Database
DATABASE_URL=postgresql+asyncpg://hdesk:hdesk_secret@localhost:5432/hdesk_db
DATABASE_URL_SYNC=postgresql+psycopg2://hdesk:hdesk_secret@localhost:5432/hdesk_db

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Dashboard
DASH_HOST=0.0.0.0
DASH_PORT=8050

# Risk Parameters
DEFAULT_RISK_FREE_RATE=0.035
DEFAULT_VAR_CONFIDENCE=0.99
DEFAULT_VAR_LOOKBACK_DAYS=252
RISK_LIMIT_NET_DELTA=1000
RISK_LIMIT_NET_VEGA=500000

# Bloomberg (선택 사항)
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
